# Copy to .env for local development: cp .env.example .env
# Never commit .env. In production these come from a Kubernetes Secret / CI secrets.

# Required
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Generate with: openssl rand -hex 32
TOKEN_SECRET=<random-64-char-hex-string>

# Optional
PORT=4000
EXPIRATION_TIME=1h
NODE_ENV=development
